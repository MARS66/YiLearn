<custom-layout title="文字详情">
  <view class="detail-page">
    <view class="memory-card" aria-role="img" aria-label="彝文记忆卡">
      <view class="play-audio iconfont icon-shengyin" bindtap="onPlayAudio" aria-role="button" aria-label="播放读音"></view>
      <view class="pinyin memory-pinyin">
        <text class="initial">{{card.initial}}</text>
        <text wx:if="{{card.final}}" class="final">{{card.final}}</text>
        <text wx:if="{{card.tone}}" class="tone">{{card.tone}}</text>
      </view>
      <view class="glyph memory-glyph">{{card.g}}</view>
      <view class="facts">
        <view class="fact"><text class="fact-label">部首</text><text class="fact-value">{{card.radical}}</text></view>
        <view class="fact"><text class="fact-label">总笔画</text><text class="fact-value">{{card.strokes}}</text></view>
        <view class="fact">
          <text class="fact-label">音调</text>
          <text class="fact-value" wx:if="{{card.tone==='t'}}">高平调</text>
          <text class="fact-value" wx:if="{{card.tone==='x'}}">次高调</text>
          <text class="fact-value" wx:if="{{card.tone==='p'}}">低平调</text>
          <text class="fact-value" wx:if="{{card.tone===''}}">中平调</text>
        </view>
      </view>
      <view class="facts-group">
        <view class="grop">
          <text class="fact-label">常用词组</text>
          <view class="fact-value fact-phrase" wx:if="{{card.phrases.length === 0}}">
            <view class="phrase-yi">暂无词组</view>
          </view>
          <view class="fact-value fact-phrase" wx:for="{{card.phrases}}" wx:key="index">
            <view>
              <view class="phrase-yi">{{item.yi}}</view>
              <view class="phrase-han">{{item.han}}</view>
            </view>
            <view class="btn">
              <view class="play-icon iconfont icon-shengyin" catchtap="onPlayPhraseAudio" data-yi="{{item.yi}}" aria-role="button" aria-label="播放彝语词组"></view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>
</custom-layout>