<custom-layout show-header="{{false}}">
  <view class="page tab-page home-page">
    <view class="scroll">
      <view class="study-hero">
        <view class="hero-orb hero-orb-large" aria-hidden="true"></view>
        <view class="hero-orb hero-orb-small" aria-hidden="true"></view>

        <view class="hero-topline">
          <text class="hero-date">{{dateText}}</text>
          <view class="streak-chip" aria-label="连续学习 {{streak}} 天">
            <text class="iconfont streak-icon icon-daka-copy" aria-hidden="true"></text>
            <text>连续 <text class="streak-num">{{streak}}</text> 天</text>
          </view>
        </view>

        <view class="hero-copy">
          <text class="hero-greeting">{{greeting}}</text>
          <text class="hero-title">{{encouragement}}</text>
        </view>

        <image class="hero-mascot" src="https://bee-reg-ab.imagency.cn/mr/6209/26/b2e77f2f36e9a2fff7cdbd4ea4191b63.png" mode="widthFix" aria-role="img" aria-label="小火种陪伴学习" />

        <view class="word-card">
          <view class="word-card-head">
            <view class="word-label">
              <text class="iconfont icon-shu" aria-hidden="true"></text>
              <text>下一个字</text>
            </view>
            <text class="learned-count">已认识 {{totalLearned}} / {{totalWords}}</text>
          </view>

          <view wx:if="{{!allLearned}}" class="word-preview">
            <view class="pinyin">
              <text class="initial">{{nextWord.initial}}</text>
              <text wx:if="{{nextWord.final}}" class="final">{{nextWord.final}}</text>
              <text wx:if="{{nextWord.tone}}" class="tone">{{nextWord.tone}}</text>
            </view>
            <view class="glyph">{{nextWord.g}}</view>
          </view>
          <view wx:else class="word-preview word-preview-complete">
            <text class="complete-title">全部认识啦</text>
            <text class="complete-copy">回顾学过的文字，让记忆更熟悉</text>
          </view>

          <view class="hero-progress">
            <view class="progress-copy">
              <text>今日学习</text>
              <text><text class="progress-number">{{todayLearned}}</text> / {{todayBars.length}}</text>
            </view>
            <view class="progress-bar" aria-label="今日学习进度 {{percent}}%">
              <view wx:for="{{todayBars}}" wx:key="index" class="{{item ? 'on' : ''}}"></view>
            </view>
          </view>

          <view class="primary hero-cta" bindtap="goLearn" hover-class="hero-cta-pressed" aria-role="button" aria-label="{{buttonText}}">
            <text>{{buttonText}}</text>
            <text class="cta-arrow" aria-hidden="true">›</text>
          </view>
        </view>
      </view>

      <view class="section-head">
        <text class="section-title">轻松学一点</text>
        <text class="section-note">按自己的节奏来</text>
      </view>

      <view class="home-grid">
        <view class="quick-card review-card" bindtap="goReview" hover-class="quick-card-pressed" aria-role="button" aria-label="自主回顾，随机回顾 10 个已学字">
          <view class="quick-icon review-icon"><text class="iconfont icon-fuxi" aria-hidden="true"></text></view>
          <view class="quick-copy">
            <text class="quick-title">复习巩固</text>
            <text class="quick-note">随机回顾 10 个字</text>
          </view>
          <text class="quick-arrow" aria-hidden="true">›</text>
        </view>

        <view class="quick-card achievement-card" bindtap="goAchievements" hover-class="quick-card-pressed" aria-role="button" aria-label="查看成就">
          <view class="quick-icon achievement-icon"><text class="iconfont icon-jiangbei1" aria-hidden="true"></text></view>
          <view class="quick-copy">
            <text class="quick-title">我的成就</text>
            <text class="quick-note">看看新的里程碑</text>
          </view>
          <image class="achievement-mark" src="{{latestStreak.image}}" mode="aspectFit" aria-hidden="true" />
          <text class="quick-arrow" aria-hidden="true">›</text>
        </view>
      </view>

      <view class="week-card">
        <view class="week-head">
          <view>
            <text class="week-kicker">本周记录</text>
            <text class="week-title">每天一点，慢慢熟悉</text>
          </view>
          <view class="week-badge"><text class="iconfont icon-daka" aria-hidden="true"></text></view>
        </view>
        <view class="week">
          <view wx:for="{{week}}" wx:key="index" class="day {{item.done ? 'done' : ''}}">
            <text class="day-label">{{item.label}}</text>
            <view class="day-i">{{item.done ? '✓' : item.dayNum}}</view>
          </view>
        </view>
      </view>
    </view>
  </view>
</custom-layout>
